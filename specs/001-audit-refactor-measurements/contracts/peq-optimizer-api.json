{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEQOptimizerAPI",
  "description": "Schema for the input and output of the real PEQ optimization engine",
  "type": "object",
  "definitions": {
    "BiquadBand": {
      "type": "object",
      "required": ["band", "freq_hz", "q", "gain_db"],
      "properties": {
        "band": { "type": "integer", "minimum": 1, "maximum": 7 },
        "freq_hz": {
          "type": "number",
          "enum": [31.3, 39.4, 49.6, 62.5, 78.7, 99.2, 125.0, 157.5, 198.4, 250.0, 315.0, 396.9, 500.0, 630.0, 793.7, 1000.0, 1260.0, 1587.4, 2000.0, 2520.0, 3174.8, 4000.0, 5040.0, 6349.6, 8000.0, 10080.0, 12700.0, 16000.0]
        },
        "q": {
          "type": "number",
          "enum": [0.5, 0.63, 0.794, 1.0, 1.26, 1.587, 2.0, 2.52, 3.175, 4.0, 5.04, 6.35, 8.0, 10.08]
        },
        "gain_db": {
          "type": "number",
          "minimum": -12.0,
          "maximum": 3.0
        }
      }
    }
  },
  "properties": {
    "request": {
      "type": "object",
      "required": ["profile_key", "measurement_left_path", "measurement_right_path"],
      "properties": {
        "profile_key": { "type": "string" },
        "measurement_left_path": { "type": "string" },
        "measurement_right_path": { "type": "string" },
        "sweet_spot_weight": { "type": "number", "default": 0.8, "minimum": 0.0, "maximum": 1.0 },
        "max_boost_db": { "type": "number", "default": 3.0, "maximum": 3.0 },
        "max_cut_db": { "type": "number", "default": -12.0, "minimum": -12.0 }
      }
    },
    "response": {
      "type": "object",
      "required": ["success", "channels", "metrics"],
      "properties": {
        "success": { "type": "boolean" },
        "channels": {
          "type": "object",
          "required": ["left", "right"],
          "properties": {
            "left": {
              "type": "array",
              "items": { "$ref": "#/definitions/BiquadBand" },
              "minItems": 7,
              "maxItems": 7
            },
            "right": {
              "type": "array",
              "items": { "$ref": "#/definitions/BiquadBand" },
              "minItems": 7,
              "maxItems": 7
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": ["predicted_rms_reduction_db", "predicted_modal_attenuation_db", "execution_time_ms"],
          "properties": {
            "predicted_rms_reduction_db": { "type": "number" },
            "predicted_modal_attenuation_db": { "type": "number" },
            "execution_time_ms": { "type": "number" }
          }
        }
      }
    }
  }
}
