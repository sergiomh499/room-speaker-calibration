{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CalibrationEpochManifest",
  "description": "Schema for immutable epoch calibration manifests",
  "type": "object",
  "required": [
    "epoch_index",
    "epoch_id",
    "stage",
    "timestamp",
    "profile_key",
    "active_peq",
    "metrics",
    "provenance"
  ],
  "properties": {
    "epoch_index": { "type": "integer", "minimum": 0 },
    "epoch_id": { "type": "string", "pattern": "^epoch_[0-9]{3}_[a-z0-9_]+$" },
    "stage": {
      "type": "string",
      "enum": ["baseline", "initial_peq", "refined_notch", "final_certified"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "profile_key": { "type": "string" },
    "active_peq": {
      "type": "object",
      "required": ["left", "right"],
      "properties": {
        "left": { "type": "array" },
        "right": { "type": "array" }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "modal_peak_attenuation_db",
        "residual_rms_error_db",
        "stereo_imbalance_db",
        "snr_db",
        "s_tier_certified"
      ],
      "properties": {
        "modal_peak_attenuation_db": { "type": "number" },
        "residual_rms_error_db": { "type": "number" },
        "stereo_imbalance_db": { "type": "number" },
        "snr_db": { "type": "number" },
        "s_tier_certified": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["rir_left_sha256", "rir_right_sha256", "hardware_readback_verified"],
      "properties": {
        "rir_left_sha256": { "type": "string" },
        "rir_right_sha256": { "type": "string" },
        "hardware_readback_verified": { "type": "boolean" }
      }
    },
    "report_path": { "type": "string" }
  }
}
